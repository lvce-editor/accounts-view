{
  "name": "@lvce-editor/accounts-view-monorepo",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:static": "node packages/build/src/build-static.ts",
    "build:release": "node packages/build/src/build.ts",
    "dev": "node packages/build/src/dev.ts",
    "e2e": "npm run e2e --workspace=packages/e2e",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc --build",
    "build:watch": "node packages/build/src/build.ts --watch"
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.14.2",
    "@types/node": "^22.20.1",
    "eslint": "^10.12.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  }
}
