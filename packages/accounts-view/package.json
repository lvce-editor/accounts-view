{
  "name": "@lvce-editor/accounts-view",
  "version": "0.0.0-dev",
  "description": "Accounts View Worker",
  "type": "module",
  "main": "src/accountsWorkerMain.ts",
  "scripts": {
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "jest": {
    "injectGlobals": false,
    "testEnvironment": "node",
    "cacheDirectory": "<rootDir>/../../.tmp/jest/accounts-view",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.tmp/"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext",
            "esModuleInterop": true
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@lvce-editor/constants": "^5.30.0",
    "@lvce-editor/rpc": "^6.21.1",
    "@lvce-editor/rpc-registry": "^9.66.0",
    "@lvce-editor/viewlet-registry": "^5.12.0",
    "@lvce-editor/virtual-dom-worker": "^11.22.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14"
  }
}
