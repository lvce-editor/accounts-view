{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/build": {
      "entry": ["src/*.ts"],
      "project": ["src/*.ts"],
      "ignoreDependencies": ["esbuild"]
    },
    "packages/accounts-view": {
      "entry": ["src/accountsWorkerMain.ts", "test/*.test.ts"],
      "project": ["src/**/*.ts", "test/*.ts"]
    },
    "packages/e2e": {
      "entry": ["playwright.config.ts", "src/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/server": {
      "entry": ["src/server.js"],
      "project": ["src/*.js"]
    }
  }
}
